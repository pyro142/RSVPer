{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rsvper",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // One Worker serves the guest card, the admin dashboard and the API.
  //
  // Static files live in ./public. The Worker runs first for everything except
  // the long-lived static folders, so it can add headers that depend on your
  // settings (e.g. search-engine indexing) and guard /admin.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/vendor/*", "!/img/*"],
  },

  // D1 database. There is deliberately no `database_id` here: the Deploy to
  // Cloudflare button (and `wrangler deploy`) provision one for you. For local
  // development nothing needs creating; Wrangler keeps a local copy under
  // .wrangler/. See README → "Manual deploy" if you deploy by hand.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rsvper",
      "migrations_dir": "migrations",
    },
  ],

  // Non-secret configuration. Secrets (ADMIN_PASSWORD, SESSION_SECRET and the
  // optional Turnstile/Access values) are listed in .dev.vars.example.
  "vars": {
    // "password" (default) or "access" (Cloudflare Access / Zero Trust).
    "ADMIN_AUTH_MODE": "password",
  },
}
